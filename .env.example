# Optional: Waypoint Connect source builds. Cloud features remain disabled until
# you provide credentials and endpoints for infrastructure you control.
# Do not add server-side secrets to this file.

# Optional: enable SSH bootstrap and service installs using an npm package you own.
# Unset by default because this source fork has no published package.
# WAYPOINT_NPM_PACKAGE=@your-scope/waypoint

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# WAYPOINT_CLERK_PUBLISHABLE_KEY=pk_test_...
# WAYPOINT_CLERK_JWT_TEMPLATE=waypoint-relay
# WAYPOINT_CLERK_CLI_OAUTH_CLIENT_ID=...
# WAYPOINT_CLERK_RELYING_PARTY=clerk.example.com

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in WAYPOINT_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# WAYPOINT_APPLE_TEAM_ID=ABC1234567
# WAYPOINT_MACOS_PROVISIONING_PROFILE=/absolute/path/to/waypoint.provisionprofile
# WAYPOINT_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# WAYPOINT_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to the reserved, non-routable https://waypoint.invalid address.
# WAYPOINT_HOSTED_APP_URL=https://waypoint.example.com

# Optional Expo/EAS ownership and OTA deployment. These intentionally have no
# inherited Waypoint defaults.
# WAYPOINT_MOBILE_UPDATE_URL=https://u.expo.dev/your-project-id
# WAYPOINT_EAS_PROJECT_ID=your-project-id
# WAYPOINT_EAS_OWNER=your-eas-owner

# Public, ingest-only mobile OpenTelemetry configuration.
# WAYPOINT_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# WAYPOINT_MOBILE_OTLP_TRACES_DATASET=waypoint-mobile-traces-dev
# WAYPOINT_MOBILE_OTLP_TRACES_TOKEN=xaat-...
